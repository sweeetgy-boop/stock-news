# ★ 이 파일은 **템플릿**입니다. git 이 추적합니다. 실제 키를 여기 적지
#   마십시오. `.env` 에만 적습니다. (.gitignore 가 .env 는 제외하고
#   .env.example 은 되살리므로, 여기 적은 값은 커밋에 그대로 실립니다.)
#   스모크 테스트가 이 파일의 비밀 키 값이 비어 있는지 검사합니다.
#
# 이 파일을 .env 로 복사해서 값을 채우십시오.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
#
# 저장소 루트의 .env 는 run_screen.py 가 자동으로 읽습니다.
# 이미 설정된 OS 환경변수가 이 파일보다 우선합니다.
# 빈 값(KEY=)은 '미설정'으로 취급합니다.

# ── 필수: 텔레그램 발송 ──
# 봇 생성: @BotFather 에게 /newbot
TELEGRAM_BOT_TOKEN=
# 채팅방 ID. 봇을 방에 초대한 뒤
# https://api.telegram.org/bot<TOKEN>/getUpdates 로 확인
TELEGRAM_CHAT_ID=

# ── 선택: DART 공시 / 자본잠식 플래그 ──
# 없으면 공시 수집과 자본잠식 판정만 건너뜁니다. 나머지는 정상 동작.
# 발급: https://opendart.fss.or.kr  (무료)
DART_API_KEY=

# ── 선택: 키움 REST API (종목별 신용잔고 실측) ──
# 발급: https://openapi.kiwoom.com  앱 등록 후 앱키/시크릿
# 없으면 --mode credit 이 수동 CSV 만 씁니다.
# 조회 전용입니다. 이 시스템은 주문을 내지 않습니다.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
# 실서버 https://api.kiwoom.com  /  모의 https://mockapi.kiwoom.com
# 모의투자만 3개월 접속하면 서비스가 자동 해지되므로 실서버를 권합니다.
KIWOOM_API_BASE=https://api.kiwoom.com
# REST 유량 제한. 키움이 수치를 공개하지 않아 보수적 기본값으로 시작하고,
# return_code 1700/1701/1702 나 HTTP 429 를 받으면 스스로 절반으로 줄입니다.
# 실제 제한을 알게 되면 여기만 고치십시오 (기본 3 / 60 / 900).
KIWOOM_REST_PER_SECOND=
KIWOOM_REST_PER_MINUTE=
KIWOOM_REST_PER_HOUR=

# ── 선택: KRX 신용잔고 bld 코드 ──
# KRX 는 현재 종목별 신용거래융자 잔고를 공개하지 않습니다.
# 정책이 바뀌어 화면이 생기면 --mode credit-probe 로 bld 를 찾아 넣으십시오.
# 비워두면 네트워크 요청조차 하지 않습니다.
KRX_CREDIT_BLD=

# ── 선택: 키움 OpenAPI+ (구 32비트 OCX 경로) ──
# REST 경로를 쓰면 필요 없습니다. OCX 설치 위치가 기본값과 다를 때만.
# 기본값 C:\OpenAPI
KIWOOM_OPENAPI_DIR=

# ── 운영 ──
# 국내장 기준으로 동작합니다. 호스트 타임존이 UTC 라도 이 값을 씁니다.
TZ=Asia/Seoul
