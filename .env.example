# 이 파일을 .env 로 복사해서 값을 채우십시오. .env 는 커밋되지 않습니다.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)

# ── 필수: 텔레그램 발송 ──
# 봇 생성: @BotFather 에게 /newbot
TELEGRAM_BOT_TOKEN=
# 채팅방 ID. 봇을 방에 초대한 뒤
# https://api.telegram.org/bot<TOKEN>/getUpdates 로 확인
TELEGRAM_CHAT_ID=

# ── 선택: DART 공시 / 자본잠식 플래그 ──
# 없으면 공시 수집과 자본잠식 판정만 건너뛴다. 나머지는 정상 동작.
# 발급: https://opendart.fss.or.kr  (무료)
DART_API_KEY=

# ── 운영 ──
# 국내장 기준으로 동작한다. 호스트 타임존이 UTC 라도 이 값을 쓴다.
TZ=Asia/Seoul
